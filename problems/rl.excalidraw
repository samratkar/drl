      "seed": 2021687893,
      "version": 287,
      "versionNonce": 1740686875,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785224652381,
      "link": null,
      "locked": false,
      "text": "objective of RL - take the right action \n1. start with the agent being ambivalent \n2. agent learns gradually which action if it takes will give it best reward. - policy\n3. agent gradually builds a table - policy \n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "objective of RL - take the right action \n1. start with the agent being ambivalent \n2. agent learns gradually which action if it takes will give it best reward. - policy\n3. agent gradually builds a table - policy \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
